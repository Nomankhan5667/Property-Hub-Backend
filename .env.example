# MongoDB Connection String (Atlas or Local)
# Atlas Example: mongodb+srv://<username>:<password>@<cluster-subdomain>.mongodb.net/propertyhub?retryWrites=true&w=majority
# Local Example: mongodb://127.0.0.1:27017/propertyhub
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/propertyhub?retryWrites=true&w=majority

PORT=5000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:5173

# JWT Security
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Setup (Image storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer / SMTP (Optional - for email notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=PropertyHub <noreply@propertyhub.com>

# Gemini AI (Optional - for AI features)
GEMINI_API_KEY=your_gemini_api_key
